# Google Gemini Key
GOOGLE_API_KEY=

# Anthropic Claude Key
ANTHROPIC_API_KEY=

# OpenAI Key
OPENAI_API_KEY=

# Backend logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Qdrant configuration (run via `docker compose up -d`)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=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
QDRANT_COLLECTION_NAME="ragindex"

# PostgreSQL configuration (run via `docker compose up -d`) — chat log + user accounts
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/rag_pipeline"
JWT_SECRET="change-this-secret-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION="1024"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# LangSmith tracing (optional) — set LANGCHAIN_TRACING_V2=true and an API key
# from https://smith.langchain.com/settings to see every LLM/chain run (intent
# classification, query rewrite, RAG generation) in the LangSmith UI.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="imka-knowledge-assistant"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
