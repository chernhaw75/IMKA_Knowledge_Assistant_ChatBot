# Google Gemini Key
GOOGLE_API_KEY=

# Anthropic Claude Key
ANTHROPIC_API_KEY=

# OpenAI Key
OPENAI_API_KEY=

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Qdrant configuration (run via `docker compose up -d`)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME="ragindex"

# PostgreSQL configuration (run via `docker compose up -d`) — chat log + user accounts
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/rag_pipeline"
JWT_SECRET="change-this-secret-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION="1024"
OPENAI_CHAT_MODEL="gpt-4o-mini"
